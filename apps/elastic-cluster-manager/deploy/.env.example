# Copy to deploy/.env (gitignored) and fill in. Never commit the real file.

# Postgres (used by compose for both the db container and the app)
POSTGRES_PASSWORD=CHANGE_ME_long_random

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several keys to rotate (first encrypts, all decrypt).
ECM_MASTER_KEY=CHANGE_ME

ECM_ADMIN_USERNAME=admin
# Generate: python -m app.hashpw   (wrap the value in single quotes: it contains '$')
ECM_ADMIN_PASSWORD_HASH='CHANGE_ME'

# Set false only for plain-HTTP local development
ECM_SECURE_COOKIES=true

# Wizard defaults. Template is selected by Proxmox VMID (name is a fallback if VMID unset).
ECM_DEFAULT_TEMPLATE_VMID=8000
ECM_DEFAULT_TEMPLATE_NAME=ubuntu-25.04
ECM_DEFAULT_STORAGE=tank

# Background discovery refresh interval in minutes (1-59)
ECM_SYNC_INTERVAL_MINUTES=5

# Terraform state. Optional: by default the worker keeps it in ECM's own database (one schema per cluster),
# built from the database settings above, so any password works. Set this to a libpq URL to use a separate
# database, and percent-encode any of  # / ? @ : %  in its password (# is %23). The worker hands it to Terraform
# as PG_CONN_STR.
# ECM_TF_STATE_URL=postgresql://USER:PASSWORD@postgres:5432/tfstate?sslmode=disable
# Terraform's driver requires TLS unless the URL says sslmode=disable, and the bundled Postgres has no TLS.
# For the default (derived) connection, ECM_TF_STATE_SSLMODE sets it: disable (default), require, verify-ca, verify-full.

# How many VMs Terraform clones (or destroys) at once, 1 to 10. Proxmox serializes clones onto one storage with a
# cluster-wide lock and gives up waiting for it after 60 seconds: a 7-node create at Terraform's default of 10 failed
# that way on `tank`, three at once did not. A lower number is slower and safer. Default 2.
# ECM_TF_PARALLELISM=2

# SSH for configuring the VMs ECM creates. The worker mounts this one file, read-only, at /run/ecm/ssh/github_rsa.
# The worker runs as uid 10001, so give it a copy of the key that it owns, mode 0600, outside your own ~/.ssh:
#   sudo install -d -m 700 -o 10001 -g 10001 /srv/ecm/ssh
#   sudo install -m 600 -o 10001 -g 10001 /home/bret/.ssh/github_rsa /srv/ecm/ssh/github_rsa
# Do not use an ACL on your own key: it makes ssh refuse the key for you (see "SSH key delivery" in docs/DECISIONS.md).
ECM_SSH_USER=bret
ECM_SSH_KEY_FILE=/srv/ecm/ssh/github_rsa
